{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Git: fetch remotes (on folder open)",
      "type": "shell",
      "command": "git fetch --all --prune",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "silent",
        "panel": "shared",
        "showReuseMessage": false,
        "clear": true
      },
      "runOptions": {
        "runOn": "folderOpen"
      }
    }
  ]
}
